{
  "name": "appium-ts-mobile-framework",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "android:bs": "npx wdio configs/wdio.android.conf.ts",
    "ios:bs": "npx wdio configs/wdio.ios.conf.ts",
    "local:android": "cross-env LOCAL_APPIUM=true npx wdio configs/wdio.android.conf.ts",
    "local:ios": "cross-env LOCAL_APPIUM=true npx wdio configs/wdio.ios.conf.ts",
    "clean:allure": "rimraf ./allure-results ./allure-report",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "android:ap": "cross-env LOCAL_APPIUM=true PLATFORM=android npx wdio configs/wdio.android.conf.ts",
    "ios:ap": "cross-env LOCAL_APPIUM=true PLATFORM=ios npx wdio configs/wdio.ios.conf.ts",
    "android:inspect": "cross-env LOCAL_APPIUM=true PLATFORM=android PAUSE_FOR_INSPECTION=true npx wdio configs/wdio.android.conf.ts",
    "prepare": "husky"
  },
  "author": "Lakshya Sharma (LakshyaQA) <https://github.com/LakshyaQA>",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "volta": {
    "node": "22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.3",
    "@wdio/allure-reporter": "^9.24.0",
    "@wdio/appium-service": "^9.27.0",
    "@wdio/browserstack-service": "^9.24.0",
    "@wdio/cli": "^9.24.0",
    "@wdio/config": "^9.24.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/mocha-framework": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "@wdio/types": "^9.24.0",
    "@wdio/visual-service": "^9.1.6",
    "allure-commandline": "^2.37.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "webdriverio": "^9.24.0"
  },
  "dependencies": {
    "allure-js-commons": "^3.5.0",
    "browserstack-local": "^1.5.12"
  },
  "overrides": {
    "tar": ">=7.5.7",
    "diff": ">=8.0.3",
    "fast-xml-parser": ">=5.3.4",
    "serialize-javascript": ">=7.0.3"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
