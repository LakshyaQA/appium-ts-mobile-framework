# ☁️ BrowserStack Credentials
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# 📦 BrowserStack App URLs
# (Obtainable via BrowserStack Upload API)
BS_ANDROID_APP_URL=
BS_IOS_APP_URL=

# 📍 App Environment Configuration
# Selection used by EnvHelper to choose correct credentials and server-side env.
# Allowed: DEV | ST | UAT
APP_ENV=DEV

# 🔑 Manual Credential Overrides
# Set these if you want to bypass logindata.json and force specific credentials.
LOGIN_EMAIL=
LOGIN_PASSWORD=

# 🖥️ Local Execution Toggles
# Set LOCAL_APPIUM=true to run against a local emulator/simulator.
LOCAL_APPIUM=true
PAUSE_FOR_INSPECTION=false

# 📱 Local Capabilities (Android)
# If provided, these override the defaults in wdio.android.conf.ts
ANDROID_DEVICE_NAME="Test Phone API 36.1"
ANDROID_PLATFORM_VERSION=16.0
ANDROID_AVD_NAME="Test_Phone_API_36.1"
LOCAL_ANDROID_APP_PATH=

# 🍎 Local Capabilities (iOS)
# If provided, these override the defaults in wdio.ios.conf.ts
IOS_DEVICE_NAME="iPhone 15"
IOS_PLATFORM_VERSION=17.0
LOCAL_IOS_APP_PATH=

# 🔗 BrowserStack Local (Tunneling)
BS_LOCAL=false
BS_FORCE_LOCAL=false
BS_LOCAL_IDENTIFIER=local-dev

# 🏷️ Metadata & Reporting
PROJECT_NAME="appium-ts-mobile-framework"
BUILD_NAME="Manual Execution"
# To Run framework Ask for KEY at lakshyasharmaqa@gmail.com
